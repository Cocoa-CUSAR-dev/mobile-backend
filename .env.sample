# Copy this file to `.env` and fill in real values. Never commit the real .env.

# Database (NeonDB)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require        # required for Neon

# Server
PORT=8080
GIN_MODE=debug            # release in production

# CORS — only needed for browser-based callers (e.g. a Flutter web build).
# Comma-separated, no spaces. Leave empty to block all browser cross-origin
# access (native mobile app calls are unaffected either way).
CORS_ALLOWED_ORIGINS=      # e.g. https://<username>.github.io,http://localhost:5000

# JWT
JWT_KEY=                  # secret signing key — generate a strong random value
JWT_NAME=cocoa_mobile_jwt
JWT_ACCESS_TOKEN_EXPIRATION=   # seconds (e.g. 3600 = 1 hour)
JWT_REFRESH_TOKEN_EXPIRATION=  # seconds (e.g. 86400 = 24 hours)

# LINE LIFF (static/liff-test/ test kit)
LINE_CHANNEL_ID=          # Channel ID ของ LINE Login/Messaging API channel ที่ผูก LIFF app ไว้


# web-backend (Kotlin) — for proxying farmer-scoped form reads.
# JWT_KEY above must match web-backend's JWT_KEY for the Bearer forward to validate.
# If this service runs in Docker but web-backend runs on the host, use
# host.docker.internal instead of localhost so the container can reach it.
WEB_BACKEND_URL=http://localhost:3001/api/v1

# Chatbot service auth — POST /service/tasks, gated by ServiceAuthMiddleware
# (separate trust model from farmer JWT cookies, see that middleware's own
# comment). Generate a strong random value; the chatbot's own .env needs the
# SAME value, sent as the X-Service-Key header.
CHATBOT_SERVICE_KEY=

# Opposite direction — this service calling GET /service/forms/{formId} for
# answer validation. Same value as web-backend's CHATBOT_SERVICE_KEY.
KOTLIN_SERVICE_KEY=

# Farm photos -- Cloudflare R2 (S3-compatible). Leave any of these blank to
# run without image storage: POST /farms/:farm_id/image then answers 503 and
# GET /farms returns image_url: null. Use an "Object Read & Write" API token
# scoped to this one bucket, and the -dev bucket for anything but production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                # cocoa-farm-images-dev / cocoa-farm-images-prod

# Error tracking (X-2d). Leave blank to disable the SDK entirely (safe for
# local dev/CI) -- get the real DSN from the team's Sentry project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
